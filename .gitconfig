[credential]
	helper = osxkeychain
[ghq]
	root = /Users/yuki/src
[core]
	excludesfile = /Users/yuki/.gitignore
	autocrlf = input
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[user]
	name = chus0n
	email = 12948191+chus0n@users.noreply.github.com
[pull]
	rebase = false
[secrets]
	providers = git secrets --aws-provider
	patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
	patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
	patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
	allowed = AKIAIOSFODNN7EXAMPLE
	allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
	patterns = gh[pousr]_[A-Za-z0-9]{36}
	patterns = github_pat_[A-Za-z0-9_]{60,}
	patterns = (^|[^A-Za-z0-9])sk-(ant-|proj-)?[A-Za-z0-9_-]{32,}
	patterns = xox[abposr]-[A-Za-z0-9-]{10,}
	patterns = AIza[0-9A-Za-z_-]{35}
	patterns = BEGIN[A-Z_[:blank:]]*PRIVATE[[:blank:]]KEY
[init]
	templatedir = ~/.git-templates/git-secrets
	defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
